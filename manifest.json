{
  "manifest_version": 3,
  "name": "Route & Environment Helper",
  "version": "1.2.0",
  "description": "Proxy configuration and page environment helper.",
  "permissions": [
    "proxy",
    "storage",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.lifepointspanel.com/*",
        "*://*.lifepoints.com/*"
      ],
      "js": [
        "content-scripts/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
