{
  "manifest_version": 3,
  "name": "LifePoints Helper",
  "version": "1.0.0",
  "description": "Extension helper for target sites.",
  "content_scripts": [
    {
      "matches": [
        "*://*.lifepointspanel.com/*",
        "*://*.lifepoints.com/*"
      ],
      "js": [
        "content-scripts/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
